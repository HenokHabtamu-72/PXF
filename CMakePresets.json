{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows — Visual Studio 2022 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-tests",
      "displayName": "Windows — Visual Studio 2022 (x64) + engine tests",
      "inherits": "windows",
      "cacheVariables": { "PXF_BUILD_TESTS": "ON" }
    },
    {
      "name": "macos",
      "displayName": "macOS — Xcode",
      "inherits": "base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-tests",
      "displayName": "macOS — Xcode + engine tests",
      "inherits": "macos",
      "cacheVariables": { "PXF_BUILD_TESTS": "ON" }
    },
    {
      "name": "linux",
      "displayName": "Linux — Unix Makefiles",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux — Unix Makefiles + engine tests",
      "inherits": "linux",
      "cacheVariables": { "PXF_BUILD_TESTS": "ON" }
    }
  ],

  "buildPresets": [
    { "name": "windows",       "configurePreset": "windows",       "configuration": "Release", "targets": ["PXF_VST3"] },
    { "name": "windows-tests", "configurePreset": "windows-tests", "configuration": "Release", "targets": ["pxf_tests"] },
    { "name": "macos",         "configurePreset": "macos",         "configuration": "Release" },
    { "name": "macos-tests",   "configurePreset": "macos-tests",   "configuration": "Release", "targets": ["pxf_tests"] },
    { "name": "linux",         "configurePreset": "linux",         "targets": ["PXF_VST3"] },
    { "name": "linux-tests",   "configurePreset": "linux-tests",   "targets": ["pxf_tests"] }
  ],

  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows-tests",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos",
      "configurePreset": "macos-tests",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux",
      "configurePreset": "linux-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
